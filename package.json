{
  "name": "the-hedgehogs-dilemma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive audiovisual installation: a white room, a small wooden chair, and words on the walls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tests/smoke.mjs",
    "audition": "node scripts/audition.mjs",
    "playtest": "vite-node scripts/playtest.ts",
    "playtest:browser": "node tests/playtest/browser.mjs",
    "opening": "node tests/playtest/opening.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/nothing-you-could-do": "^5.1.0",
    "@fontsource/reenie-beanie": "^5.1.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
