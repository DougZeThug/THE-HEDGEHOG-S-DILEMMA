{
  "name": "the-hedgehogs-dilemma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive audiovisual installation: a white room, a small wooden chair, and words on the walls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tests/smoke.mjs",
    "audition": "node scripts/audition.mjs",
    "playtest": "vite-node scripts/playtest.ts",
    "playtest:browser": "node tests/playtest/browser.mjs",
    "opening": "node tests/playtest/opening.mjs",
    "perf": "node tests/playtest/perf.mjs",
    "style": "node tests/playtest/style.mjs && python3 tests/playtest/style-metrics.py ${OUT:-test-output/review/style/run}",
    "memories:seed": "vite-node scripts/seed-memories.ts",
    "bake:memories": "node scripts/bake-memories.mjs",
    "lint": "eslint src",
    "coverage": "vitest run --coverage --testTimeout=30000",
    "analyze": "ANALYZE=1 vite build",
    "a11y": "node tests/playtest/a11y.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/nothing-you-could-do": "^5.1.0",
    "@fontsource/reenie-beanie": "^5.1.0",
    "@theatre/core": "0.7.2",
    "gsap": "3.15.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@theatre/studio": "0.7.2",
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "playwright": "1.56.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5"
  }
}
