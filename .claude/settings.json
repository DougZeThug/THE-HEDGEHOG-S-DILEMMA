{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npm ci*)", "Bash(npm install*)",
      "Bash(npx tsc*)", "Bash(npx vitest*)", "Bash(npx vite-node*)", "Bash(npx vite *)", "Bash(npx eslint*)", "Bash(npx playwright*)",
      "Bash(node .claude/factory/bin/factory.mjs *)", "Bash(node --test *)", "Bash(node tests/*)", "Bash(node scripts/*--dry-run*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git branch*)", "Bash(git switch*)", "Bash(git checkout*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git fetch*)", "Bash(git worktree*)", "Bash(git stash*)", "Bash(git push -u origin claude/*)", "Bash(git push -u origin factory/*)", "Bash(git push --force-with-lease origin claude/*)",
      "Bash(ls*)", "Bash(cat *)", "Bash(grep *)", "Bash(rg *)", "Bash(mkdir *)", "Bash(curl -s http://localhost*)",
      "mcp__github__create_pull_request", "mcp__github__issue_read", "mcp__github__list_issues", "mcp__github__pull_request_read", "mcp__github__add_issue_comment", "mcp__github__update_pull_request"
    ],
    "ask": ["mcp__Supabase__execute_sql"],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push * main*)", "Bash(git push * master*)", "Bash(git push * production*)",
      "Bash(git reset --hard*)", "Bash(git clean *)", "Bash(rm -rf *)", "Bash(sudo *)",
      "Bash(gh pr merge*)", "Bash(gh release*)", "Bash(npm publish*)", "Bash(vercel *)", "Bash(supabase db *)", "Bash(supabase migration *)", "Bash(supabase functions deploy*)",
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Edit(./.env*)", "Edit(./.claude/settings*.json)", "Edit(./.claude/hooks/**)", "Edit(./.claude/factory/bin/**)",
      "mcp__github__merge_pull_request", "mcp__github__delete_file", "mcp__github__create_or_update_file", "mcp__github__push_files", "mcp__github__enable_pr_auto_merge",
      "mcp__Supabase__apply_migration", "mcp__Supabase__deploy_edge_function", "mcp__Supabase__merge_branch", "mcp__Supabase__reset_branch", "mcp__Supabase__delete_branch", "mcp__Supabase__create_edge_function_secret", "mcp__Supabase__pause_project", "mcp__Supabase__restore_project",
      "mcp__Vercel__create_deployment", "mcp__Vercel__request_promote", "mcp__Vercel__request_rollback", "mcp__Vercel__assign_alias", "mcp__Vercel__delete*", "mcp__Vercel__buy_domain", "mcp__Vercel__create_or_transfer_domain",
      "mcp__ElevenLabs__creative_generate_speech", "mcp__ElevenLabs__creative_design_voice", "mcp__ElevenLabs__creative_save_designed_voice", "mcp__ElevenLabs__creative_generate_in_flow"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/factory-guard.mjs\"", "timeout": 20 }]
      }
    ]
  }
}
